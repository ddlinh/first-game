[gd_scene load_steps=5 format=3]

; Cây scene cố ý mỏng: chỉ có nền, mặt đĩa, lớp lính và HUD. Mọi bố cục giao diện
; nằm trong hud.gd, mọi luật chơi nằm trong colony.gd — mở file này ra là thấy
; ngay bốn tầng của mục 3 tài liệu thiết kế xếp theo đúng thứ tự vẽ.

[ext_resource type="Script" path="res://scripts/colony.gd" id="1_colony"]
[ext_resource type="Script" path="res://scripts/board.gd" id="2_board"]
[ext_resource type="Script" path="res://scripts/agents.gd" id="3_agents"]
[ext_resource type="Script" path="res://scripts/hud.gd" id="4_hud"]

[node name="Colony" type="Node2D"]
script = ExtResource("1_colony")

[node name="Backdrop" type="CanvasLayer" parent="."]
layer = -10

[node name="Bg" type="ColorRect" parent="Backdrop"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.027451, 0.039216, 0.070588, 1)

[node name="Board" type="Node2D" parent="."]
script = ExtResource("2_board")

[node name="Grid" type="Sprite2D" parent="Board"]

[node name="Agents" type="Node2D" parent="Board"]
script = ExtResource("3_agents")

[node name="Hud" type="CanvasLayer" parent="."]
script = ExtResource("4_hud")
