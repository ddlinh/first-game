; CHIẾN TRANH KHUẨN LẠC — roguelite mô phỏng sinh thái 2.5D
; Chỉnh trong editor thì Godot sẽ ghi đè file này, cứ thoải mái sửa.

config_version=5

[application]

config/name="Chiến tranh Khuẩn Lạc"
config/description="Ba chủng vi khuẩn khắc chế vòng tròn trên đĩa thạch. Người chơi cấy quân và can thiệp, trận đánh tự diễn ra."
run/main_scene="res://scenes/Dish.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
